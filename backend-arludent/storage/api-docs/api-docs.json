{
    "openapi": "3.0.0",
    "info": {
        "title": "API Arludent - Sistema de Gestión Odontológica",
        "description": "API RESTful completa para gestión de consultorios odontológicos con autenticación JWT, MFA y módulos clínicos",
        "contact": {
            "name": "Soporte Técnico Arludent",
            "email": "soporte@arludent.com"
        },
        "license": {
            "name": "Propietario",
            "url": "https://arludent.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor de Desarrollo Local"
        },
        {
            "url": "https://api.arludent.com",
            "description": "Servidor de Producción"
        }
    ],
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "description": "Inicia sesión con credenciales",
                "operationId": "f779238bce5c5b984c773808f46fd14c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo",
                                    "password"
                                ],
                                "properties": {
                                    "correo": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Password123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                },
                                                "user": {
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión",
                "description": "Cierra sesión",
                "operationId": "a09608b2fbed6bd1841153fae1c6b7f2",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada exitosamente"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Refrescar token",
                "description": "Refresca el token JWT",
                "operationId": "29a727b701c5fac57f1f288c72ffd72b",
                "responses": {
                    "200": {
                        "description": "Token refrescado"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Obtener usuario actual",
                "description": "Obtiene el usuario autenticado",
                "operationId": "b0ad4aa2bbe6ffb9846249517a13c4b6",
                "responses": {
                    "200": {
                        "description": "Usuario actual"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/mfa/generar": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Generar código QR para MFA",
                "description": "Genera el secreto y código QR para configurar MFA",
                "operationId": "d1d6a71f4d31f02983701595e9a0e51c",
                "responses": {
                    "200": {
                        "description": "QR generado"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/mfa/activar": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Activar MFA",
                "description": "Activa MFA verificando el código inicial",
                "operationId": "4cd643b2d78cf7f0e6d8da7c3a5fc3ba",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "codigo"
                                ],
                                "properties": {
                                    "codigo": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MFA activado"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/mfa/verificar-login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Verificar código MFA en login",
                "description": "Verifica el código MFA durante el login",
                "operationId": "cfd46f7f9ec68218c425b44eadc7c5cc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "user_id",
                                    "codigo"
                                ],
                                "properties": {
                                    "user_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "codigo": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MFA verificado, token emitido"
                    }
                }
            }
        },
        "/api/auth/mfa/desactivar": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Desactivar MFA",
                "description": "Desactiva MFA",
                "operationId": "2cae5a87fa2dbdb2c4a916fd5a997a60",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "codigo"
                                ],
                                "properties": {
                                    "codigo": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MFA desactivado"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/recuperar-password": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Solicitar recuperación de contraseña",
                "description": "Solicita recuperación de contraseña",
                "operationId": "2b04fcfb2d23fdf809c1ae241d1b6c09",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo"
                                ],
                                "properties": {
                                    "correo": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Correo de recuperación enviado"
                    }
                }
            }
        },
        "/api/auth/restablecer-password": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Restablecer contraseña",
                "description": "Restablece la contraseña con el token",
                "operationId": "b2544e43fa9d57a2a93632c3f54ed20b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo",
                                    "token",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "correo": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "token": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contraseña restablecida exitosamente"
                    }
                }
            }
        },
        "/api/auth/cambiar-password": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cambiar contraseña",
                "description": "Cambia la contraseña del usuario autenticado",
                "operationId": "ae7af611caab6d201fbeb803d43e7151",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "password_actual",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "password_actual": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contraseña cambiada exitosamente"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
        "/api/auth/registro": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registrar nuevo usuario",
                "description": "Crea un nuevo usuario y envía correo de verificación",
                "operationId": "31bbb21b8bd1e9fca313e9ee91caa5f9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "juanperez"
                                    },
                                    "correo": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "description": "Mínimo 8 caracteres, incluir mayúsculas, minúsculas, números y símbolos",
                                        "type": "string",
                                        "format": "password",
                                        "example": "Password123!"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Password123!"
                                    },
                                    "telefono": {
                                        "type": "string",
                                        "example": "+51987654321"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Usuario registrado exitosamente. Por favor, verifica tu correo electrónico."
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "properties": {
                                                        "id_usuario": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "username": {
                                                            "type": "string",
                                                            "example": "juanperez"
                                                        },
                                                        "correo": {
                                                            "type": "string",
                                                            "example": "juan@example.com"
                                                        },
                                                        "estado": {
                                                            "type": "string",
                                                            "example": "pendiente"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Errores de validación",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Errores de validación"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/verificar-correo": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Verificar correo electrónico",
                "description": "Verifica el correo electrónico con el token",
                "operationId": "9f1a2cc83790efb063f48f8c8cee9122",
                "parameters": [
                    {
                        "name": "token",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Correo verificado exitosamente"
                    }
                }
            }
        },
        "/api/auth/reenviar-verificacion": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Reenviar correo de verificación",
                "description": "Reenvía el correo de verificación",
                "operationId": "573d983ee6d7f9dae3c4a8a342f5559e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo"
                                ],
                                "properties": {
                                    "correo": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Correo reenviado"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "description": "Autenticación mediante token JWT. Formato: Bearer {token}",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Endpoints de registro, login, verificación de correo, MFA y recuperación de contraseña"
        }
    ]
}